# Copie para .env. Execute a API a partir da pasta api/
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/sistema_doacao?charset=utf8mb4

# OBRIGATÓRIO (mín. 32 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Admin: o mesmo usuário/hash do .env do PHP serve (bcrypt $2y$). Use aspas simples por causa dos "$".
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''

# Pasta onde as imagens das roupas são gravadas (mesma do app PHP)
UPLOAD_DIR=../public/uploads

# Só para desenvolvimento: devolve o código de verificação na resposta do cadastro
EXPOSE_VERIFICATION_CODE=false
CORS_ORIGINS=["http://localhost:8080"]
